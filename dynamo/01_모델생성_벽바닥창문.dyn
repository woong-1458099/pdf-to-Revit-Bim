16.779,692.747],[565.651,474.772],[670.755,498.086],[691.377,279.16],[576.498,253.371],[566.853,293.276],[405.941,257.245],[405.724,248.071],[403.741,245.428],[405.476,237.617],[403.955,236.633],[288.781,210.801],[272.847,278.174],[262.766,284.428],[251.415,335.116],[237.074,399.634],[243.433,409.948]],\"holes\":[[[281.092,469.115],[292.604,417.64],[254.601,409.141],[243.089,460.616]],[[331.064,566.575],[347.18,494.606],[272.513,477.886],[256.397,549.855]]]},\"6\":{\"walls\":[[249.304,400.254,241.039,398.456,5.424,0],[315.586,415.105,297.653,411.038,5.596,0],[297.663,410.99,249.327,400.153,5.596,0],[383.924,317.154,359.847,424.967,5.612,0],[249.304,400.254,200.384,618.851,5.622,0],[290.761,214.977,401.214,239.69,5.635,0],[290.761,214.977,273.977,289.597,5.618,0],[200.384,618.851,205.894,620.13,5.626,0],[241.039,398.456,265.649,287.737,5.64,0],[591.308,343.192,513.179,688.947,5.652,0],[508.365,687.9,513.179,688.947,5.646,0],[401.214,239.69,385.139,311.64,5.669,0],[340.28,304.41,265.649,287.737,5.662,0],[339.132,309.924,340.279,304.412,5.655,0],[293.317,430.353,297.653,411.038,5.656,0],[383.168,313.994,340.279,304.412,5.658,0],[340.358,304.43,315.586,415.105,5.66,0],[282.899,477.401,347.725,491.894,5.662,0],[561.245,295.781,396.877,259.103,5.702,0],[371.822,578.55,403.704,436.18,5.674,0],[359.847,424.967,404.01,434.815,5.688,0],[371.822,578.55,217.144,543.961,5.702,0],[282.91,477.351,287.121,457.967,5.714,0],[234.474,466.522,282.91,477.351,5.763,0],[383.784,311.233,382.528,316.858,8.465,0],[400.928,435.562,406.437,436.787,8.508,0]],\"arcs\":[],\"windows\":[[235.1,463.71,216.53,546.71],[209.04,580.17,202.86,607.78],[357.07,229.81,379.16,234.76],[255.19,334.78,260.13,312.57],[588.2,356.94,575.7,412.25],[572.6,426.0,560.1,481.3],[556.98,495.1,544.49,550.36],[541.38,564.15,528.87,619.5],[397.53,256.18,396.29,261.71],[277.0,290.27,271.26,288.99],[510.26,284.4,454.92,272.05]],\"doors\":[[391.933,488.744,402.467,441.704,5.674,0.9758,0.2185,2,\"\"],[377.557,312.74,355.533,307.82,5.658,0.218,-0.9759,1,\"a\"],[338.802,311.383,333.538,334.898,5.66,-0.9759,-0.2184,1,\"a\"]],\"slab\":[[197.134,621.807],[507.74,691.471],[515.61,693.183],[516.923,692.154],[603.601,301.528],[405.941,257.235],[405.687,246.495],[404.147,243.618],[405.463,237.757],[404.091,236.663],[288.819,210.807],[272.847,278.174],[262.758,284.461],[251.4,335.184],[237.045,399.765],[243.437,409.954],[198.992,608.328],[196.388,620.311]],\"holes\":[[[281.092,469.115],[292.604,417.64],[254.601,409.141],[243.089,460.616]],[[331.064,566.575],[347.18,494.606],[272.513,477.886],[256.397,549.855]]]},\"7\":{\"walls\":[[234.472,466.52,290.734,214.957,5.572,0],[200.406,618.855,513.892,689.114,5.588,0],[217.159,543.964,200.406,618.855,5.599,0],[290.734,214.957,401.27,239.705,5.614,0],[234.503,466.527,217.179,543.968,5.641,0],[599.925,304.43,513.892,689.114,5.643,0],[383.701,499.941,387.827,500.839,5.646,1],[371.809,578.547,389.242,501.147,5.656,1],[599.925,304.43,396.941,258.959,5.694,0],[371.809,578.547,217.179,543.968,5.702,1],[401.27,239.705,396.941,258.959,5.732,0],[234.503,466.527,387.82,500.872,5.764,1],[387.205,503.619,388.438,498.109,8.447,1]],\"arcs\":[],\"windows\":[],\"doors\":[[360.165,494.677,382.234,499.621,5.764,0.2186,-0.9758,1,\"a\"]],\"slab\":[[197.221,621.824],[515.637,693.188],[516.928,692.128],[603.645,301.547],[405.958,257.242],[405.695,246.541],[404.14,243.651],[405.458,237.791],[404.124,236.672],[288.874,210.82],[287.713,212.086],[196.372,620.398]],\"holes\":[[[331.064,566.575],[347.18,494.606],[272.513,477.886],[256.397,549.855]]]}}''')\ndoc = DocumentManager.Instance.CurrentDBDocument\nMM = 1.0 / 304.8\nlog = []\n\n\ndef ename(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n\ndef tag_of(e):\n    p = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n    return p.AsString() if p is not None else None\n\n\ndef set_tag(e):\n    p = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n    if p is not None and not p.IsReadOnly:\n        p.Set(TAG)\n\n\ndef bip(name):\n    return getattr(BuiltInParameter, name, None)\n\n\ndef snap_mm(mm):\n    mm = int(round(mm / 10.0) * 10)\n    for target in (200, 300):\n        if abs(mm - target) <= 35:\n            return target\n    return mm\n\n\nlevels = sorted(FilteredElementCollector(doc).OfClass(Level).ToElements(), key=lambda l: l.Elevation)\nlv_by_name = dict((ename(l), l) for l in levels)\nimages = {}\nfor img in FilteredElementCollector(doc).OfClass(ImageInstance).ToElements():\n    images[ename(doc.GetElement(img.GetTypeId())).strip().lower()] = img\n\nTransactionManager.Instance.EnsureInTransaction(doc)\n\n# ── 0. 이전 결과 삭제 ──\ndef delete_tagged(cls_or_cat, is_cat=False):\n    col = FilteredElementCollector(doc).WhereElementIsNotElementType()\n    col = col.OfCategory(cls_or_cat) if is_cat else col.OfClass(cls_or_cat)\n    ids = [e.Id for e in col.ToElements() if tag_of(e) == TAG]\n    for i in ids:\n        try:\n            doc.Delete(i)\n        except Exception:\n            pass\n    return len(ids)\n\nif RUN_DOORS or RUN_WALLS:\n    n = delete_tagged(BuiltInCategory.OST_Doors, True)\n    if n: log.append('이전 자동생성 문 %d개 삭제' % n)\nif RUN_WINDOWS or RUN_WALLS:\n    n = delete_tagged(BuiltInCategory.OST_Windows, True)\n    if n: log.append('이전 자동생성 창 %d개 삭제' % n)\nif RUN_WALLS:\n    n = delete_tagged(Wall)\n    if n: log.append('이전 자동생성 벽 %d개 삭제' % n)\nif RUN_FLOORS:\n    n = delete_tagged(Floor)\n    if n: log.append('이전 자동생성 바닥 %d개 삭제' % n)\n\n# ── 1. PDF 정렬 ──\nif ALIGN_TO_1F and '1.pdf' in images:\n    c1 = images['1.pdf'].GetLocation(BoxPlacement.Center)\n    for fl in ['2', '3', '4', '5', '6', '7']:\n        img = images.get('%s.pdf' % fl)\n        if img is None or abs(img.Width - images['1.pdf'].Width) > 1e-3:\n            continue\n        was = img.Pinned\n        if was: img.Pinned = False\n        img.SetLocation(XYZ(c1.X, c1.Y, img.GetLocation(BoxPlacement.Center).Z), BoxPlacement.Center)\n        if was: img.Pinned = True\n    doc.Regenerate()\n\n\ndef frame(fl):\n    img = images.get('%s.pdf' % fl)\n    lvl = lv_by_name.get(FLOOR_LEVEL[fl])\n    if img is None or lvl is None:\n        return None\n    c = img.GetLocation(BoxPlacement.Center)\n    k = img.Width / PX_W\n    left, top = c.X - img.Width / 2.0, c.Y + img.Height / 2.0\n    idx = levels.index(lvl)\n    nxt = levels[idx + 1] if idx + 1 < len(levels) else None\n    def P(x, y):\n        return XYZ(left + x * k, top - y * k, lvl.Elevation)\n    return {'P': P, 'k': k, 'lvl': lvl, 'nxt': nxt}\n\n\n# ── 2. 벽 ──\nbase_wt = next((w for w in FilteredElementCollector(doc).OfClass(WallType).ToElements() if w.Kind == WallKind.Basic), None)\nwt_cache = {}\n\ndef wall_type(mm):\n    name = 'PDF벽_%dmm' % mm\n    if name not in wt_cache:\n        found = [w for w in FilteredElementCollector(doc).OfClass(WallType).ToElements() if ename(w) == name]\n        if found:\n            wt_cache[name] = found[0]\n        else:\n            wt = base_wt.Duplicate(name)\n            wt.SetCompoundStructure(CompoundStructure.CreateSingleLayerCompoundStructure(\n                MaterialFunctionAssignment.Structure, mm * MM, ElementId.InvalidElementId))\n            wt_cache[name] = wt\n    return wt_cache[name]\n\nwalls_by_floor = {}\ndef run_walls():\n    for fl in RUN_FLOORS_LIST:\n        F = frame(fl)\n        if F is None:\n            log.append('%s층: PDF 또는 레벨 없음' % fl); continue\n        P, k, lvl, nxt = F['P'], F['k'], F['lvl'], F['nxt']\n        made = 0\n        items = [('L', w) for w in DATA[fl]['walls']] + [('A', a) for a in DATA[fl]['arcs']]\n        for kind, w in items:\n            try:\n                if kind == 'L':\n                    p1, p2 = P(w[0], w[1]), P(w[2], w[3])\n                    if p1.DistanceTo(p2) < 50 * MM: continue\n                    crv = Line.CreateBound(p1, p2); t = w[4]; inner = w[5]\n                else:\n                    crv = Arc.Create(P(w[0], w[1]), P(w[4], w[5]), P(w[2], w[3])); t = w[6]; inner = 0\n                wt = wall_type(snap_mm(t * k / MM))\n                if nxt is not None:\n                    wall = Wall.Create(doc, crv, wt.Id, lvl.Id, nxt.Elevation - lvl.Elevation, 0.0, False, False)\n                    wall.get_Parameter(BuiltInParameter.WALL_HEIGHT_TYPE).Set(nxt.Id)\n                else:\n                    h = (ROOF_STAIR_MM if inner else PARAPET_MM) * MM\n                    wall = Wall.Create(doc, crv, wt.Id, lvl.Id, h, 0.0, False, False)\n                set_tag(wall); made += 1\n            except Exception as ex:\n                log.append('%s층 벽 실패: %s' % (fl, ex))\n        log.append('%s층 벽 %d개' % (fl, made))\n    doc.Regenerate()\n\nif RUN_WALLS:\n    try:\n        run_walls()\n    except Exception as ex:\n        log.append('벽 단계 오류: %s' % ex)\n\n# 층별 자동생성 벽 목록 (창/문 호스트 찾기용)\nfor w in FilteredElementCollector(doc).OfClass(Wall).ToElements():\n    if tag_of(w) == TAG and hasattr(w.Location, 'Curve'):\n        walls_by_floor.setdefault(w.LevelId.ToString(), []).append(w)\n\n\ndef host_wall(lvl, pt):\n    best = None\n    for w in walls_by_floor.get(lvl.Id.ToString(), []):\n        c = w.Location.Curve\n        if c.GetType().Name != 'Line':\n            continue\n        r = c.Project(pt)\n        if r is None: continue\n        p0, p1 = c.GetEndParameter(0), c.GetEndParameter(1)\n        if not (min(p0, p1) + 0.05 < r.Parameter < max(p0, p1) - 0.05):\n            continue\n        d = r.Distance\n        if d < 0.5 and (best is None or d < best[0]):\n            best = (d, w)\n    return best[1] if best else None\n\n\n# ── 3. 바닥 ──\ndef run_floors():\n    fts = [f for f in FilteredElementCollector(doc).OfClass(FloorType).ToElements() if not f.IsFoundationSlab]\n    name = 'PDF슬래브_%dmm' % SLAB_MM\n    ft = next((f for f in fts if ename(f) == name), None)\n    if ft is None:\n        src = next((f for f in fts if f.GetCompoundStructure() is not None), fts[0])\n        ft = src.Duplicate(name)\n    # 기존 바닥 구조를 그대로 두고 구조층 두께만 조정해 총 두께를 SLAB_MM으로 맞춤\n    try:\n        cs = ft.GetCompoundStructure()\n        total = sum(cs.GetLayerWidth(i) for i in range(cs.LayerCount))\n        idx = cs.StructuralMaterialIndex\n        if idx < 0:\n            idx = cs.GetFirstCoreLayerIndex()\n        if idx < 0:\n            idx = 0\n        new_w = cs.GetLayerWidth(idx) + (SLAB_MM * MM - total)\n        if new_w > 10 * MM:\n            cs.SetLayerWidth(idx, new_w)\n            ft.SetCompoundStructure(cs)\n        else:\n            log.append('바닥 유형 두께 조정 불가 - 기존 두께 사용')\n    except Exception as ex:\n        log.append('바닥 유형 두께 조정 실패(기존 두께 사용): %s' % ex)\n\n    def loop(pts, P):\n        cl = CurveLoop()\n        xyz = [P(x, y) for x, y in pts]\n        clean = []\n        for q in xyz:\n            if not clean or q.DistanceTo(clean[-1]) > 5 * MM:\n                clean.append(q)\n        if clean[0].DistanceTo(clean[-1]) <= 5 * MM:\n            clean.pop()\n        for i in range(len(clean)):\n            cl.Append(Line.CreateBound(clean[i], clean[(i + 1) % len(clean)]))\n        return cl\n\n    for fl in RUN_FLOORS_LIST:\n        F = frame(fl)\n        if F is None: continue\n        try:\n            loops = List[CurveLoop]()\n            loops.Add(loop(DATA[fl]['slab'], F['P']))\n            for h in DATA[fl]['holes']:\n                loops.Add(loop(h, F['P']))\n            fl_el = Floor.Create(doc, loops, ft.Id, F['lvl'].Id)\n            set_tag(fl_el)\n            log.append('%s층 바닥 생성 (개구부 %d개)' % (fl, len(DATA[fl]['holes'])))\n        except Exception as ex:\n            log.append('%s층 바닥 실패: %s' % (fl, ex))\n    doc.Regenerate()\n\nif RUN_FLOORS:\n    try:\n        run_floors()\n    except Exception as ex:\n        log.append('바닥 단계 오류: %s' % ex)\n\n\n# ── 4. 창 / 문 공통 ──\ndef symbols(cat):\n    return [s for s in FilteredElementCollector(doc).OfClass(FamilySymbol).OfCategory(cat).ToElements()]\n\ndef fam_name(s):\n    try:\n        return s.Family.Name\n    except Exception:\n        return ''\n\ndef sized_symbol(base, prefix, mm, width_bips):\n    name = '%s_%dmm' % (prefix, mm)\n    for sid in base.Family.GetFamilySymbolIds():\n        s = doc.GetElement(sid)\n        if ename(s) == name:\n            return s\n    try:\n        s = base.Duplicate(name)\n    except Exception:\n        return base\n    ok = False\n    for b in width_bips:\n        bp = bip(b)\n        p = s.get_Parameter(bp) if bp is not None else None\n        if p is not None and not p.IsReadOnly:\n            p.Set(mm * MM); ok = True; break\n    if not ok:\n        for nm in ('폭', 'Width', '너비'):\n            p = s.LookupParameter(nm)\n            if p is not None and not p.IsReadOnly:\n                p.Set(mm * MM); ok = True; break\n    if not ok:\n        log.append('%s: 폭 변경 불가 패밀리 - 기본 크기로 배치' % fam_name(base))\n    return s\n\ndef place(sym, P, x1, y1, x2, y2, lvl):\n    if not sym.IsActive:\n        sym.Activate(); doc.Regenerate()\n    a, b = P(x1, y1), P(x2, y2)\n    mid = XYZ((a.X + b.X) / 2, (a.Y + b.Y) / 2, lvl.Elevation)\n    w = host_wall(lvl, mid)\n    if w is None:\n        return None, a, b, mid\n    inst = doc.Create.NewFamilyInstance(mid, sym, w, lvl, StructuralType.NonStructural)\n    set_tag(inst)\n    return inst, a, b, mid\n\n\n# ── 5. 창 ──\ndef run_windows():\n    ws = symbols(BuiltInCategory.OST_Windows)\n    if not ws:\n        log.append('창 패밀리가 프로젝트에 없음 → 삽입 탭에서 창 패밀리를 로드하세요')\n    else:\n        bad = ('코너', 'Corner', 'corner', '천창', 'Skylight')\n        ok_ws = [s for s in ws if not any(k in fam_name(s) for k in bad)] or ws\n        pref = [s for s in ok_ws if fam_name(s) in ('고정', 'Fixed', 'M_Fixed')]\n        pref = pref or [s for s in ok_ws if any(k in fam_name(s) for k in ('고정', 'Fixed', 'fixed'))]\n        base = (pref or ok_ws)[0]\n        cnt = 0\n        for fl in RUN_FLOORS_LIST:\n            F = frame(fl)\n            if F is None: continue\n            for o in DATA[fl]['windows']:\n                try:\n                    mm = int(round(math.hypot(o[2] - o[0], o[3] - o[1]) * F['k'] / MM / 50.0) * 50)\n                    if mm < 300: continue\n                    sym = sized_symbol(base, 'PDF창', mm, ['WINDOW_WIDTH', 'FAMILY_WIDTH_PARAM', 'FAMILY_ROUGH_WIDTH_PARAM'])\n                    inst, a, b, mid = place(sym, F['P'], o[0], o[1], o[2], o[3], F['lvl'])\n                    if inst is None:\n                        log.append('%s층 창(%dmm): 호스트 벽 없음' % (fl, mm))\n                    else:\n                        cnt += 1\n                except Exception as ex:\n                    log.append('%s층 창 실패: %s' % (fl, ex))\n        log.append('창 %d개 배치 (패밀리: %s)' % (cnt, fam_name(base)))\n\nif RUN_WINDOWS:\n    try:\n        run_windows()\n    except Exception as ex:\n        log.append('창 단계 오류: %s' % ex)\n\n# ── 6. 문 ──\ndef run_doors():\n    ds = symbols(BuiltInCategory.OST_Doors)\n    if not ds:\n        log.append('문 패밀리가 프로젝트에 없음 → 삽입 탭에서 문 패밀리를 로드하세요')\n    else:\n        dbl = [s for s in ds if any(k in fam_name(s) + ename(s) for k in ('양', '이중', 'Double', 'double'))]\n        dbl_ids = set(s.Id.ToString() for s in dbl)\n        sgl = [s for s in ds if s.Id.ToString() not in dbl_ids and not any(k in fam_name(s) for k in ('커튼', 'Curtain', '차고', 'Garage'))] or ds\n        cnt = 0\n        for fl in RUN_FLOORS_LIST:\n            F = frame(fl)\n            if F is None: continue\n            for d in DATA[fl]['doors']:\n                try:\n                    x1, y1, x2, y2, t, nx, ny, leaves, hinge = d\n                    mm = int(round(math.hypot(x2 - x1, y2 - y1) * F['k'] / MM / 50.0) * 50)\n                    base = dbl[0] if (leaves == 2 and dbl) else sgl[0]\n                    sym = sized_symbol(base, 'PDF양문' if base.Id.ToString() in dbl_ids else 'PDF문', mm,\n                                       ['DOOR_WIDTH', 'FAMILY_WIDTH_PARAM', 'FAMILY_ROUGH_WIDTH_PARAM'])\n                    inst, a, b, mid = place(sym, F['P'], x1, y1, x2, y2, F['lvl'])\n                    if inst is None:\n                        log.append('%s층 문(%dmm): 호스트 벽 없음' % (fl, mm)); continue\n                    doc.Regenerate()\n                    swing = XYZ(nx, -ny, 0)                       # PDF y축은 아래 방향\n                    want = swing if SWING_TO_FACING else swing.Negate()\n                    if inst.FacingOrientation.DotProduct(want) < 0:\n                        inst.flipFacing(); doc.Regenerate()\n                    if hinge == 'a' and leaves == 1:\n                        hv = XYZ(a.X - mid.X, a.Y - mid.Y, 0)\n                        dot = inst.HandOrientation.DotProduct(hv)\n                        if (dot < 0) == HINGE_TO_HAND:\n                            inst.flipHand(); doc.Regenerate()\n                    cnt += 1\n                except Exception as ex:\n                    log.append('%s층 문 실패: %s' % (fl, ex))\n        log.append('문 %d개 배치 (외문: %s / 양문: %s)' % (cnt, fam_name(sgl[0]), fam_name(dbl[0]) if dbl else '없음 → 외문으로 대체'))\n\nif RUN_DOORS:\n    try:\n        run_doors()\n    except Exception as ex:\n        log.append('문 단계 오류: %s' % ex)\n\nTransactionManager.Instance.TransactionTaskDone()\nOUT = log\n",
