  {
   "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
   "Code": "# -*- coding: utf-8 -*-\n# [Revit 1] 벽 + 바닥 + 창 + 문 생성\n# - 데이터 : 아래 DATA (extract/walls2.json, floors2.json 결과를 붙여 넣은 것)\n# - 좌표   : 각 층 평면뷰에 놓인 PDF 이미지의 중심·축척을 읽어 PDF pt → Revit 좌표로 변환\n# - 재실행 : 주석(Comments) = 'PDF자동생성' 요소만 지우고 새로 만듦\n# - 옵션   : RUN_WALLS / RUN_FLOORS / RUN_WINDOWS / RUN_DOORS 로 단계별 실행\n# 실행 : Dynamo > Python Script 노드(엔진 PythonNet3)에 붙여 넣거나 같은 이름의 .dyn 을 열어 실행\n#\n# PDF 평면도 → Revit 모델 자동 생성 (벽 + 바닥 + 창 + 문)\n# Dynamo Python Script 노드용. 다시 실행하면 이 스크립트가 만든 요소(주석 = PDF자동생성)를 지우고 새로 만듭니다.\nimport clr, json, math\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\nfrom Autodesk.Revit.DB.Structure import StructuralType\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nfrom System.Collections.Generic import List\n\n# ───────── 설정 ─────────\nRUN_WALLS = False             # 벽은 이미 만들어져 있으므로 이번엔 건너뜀 (벽부터 다시 만들려면 True)\nRUN_FLOORS = True\nRUN_WINDOWS = True\nRUN_DOORS = True\nALIGN_TO_1F = True            # 2층~옥상 PDF를 1층 PDF 위치로 정렬\nFLOOR_LEVEL = {'1': '1F', '2': '2F', '3': '3F', '4': '4F', '5': '5F', '6': '6F', '7': '옥상'}\nRUN_FLOORS_LIST = ['1', '2', '3', '4', '5', '6', '7']\nPARAPET_MM = 1200             # 옥상 난간벽 높이\nROOF_STAIR_MM = 3000          # 옥상 계단실 벽 높이\nSLAB_MM = 200                 # 바닥 두께\n# 문 방향: 실행 후 문이 반대로 열리면 아래 값을 True/False 바꿔서 다시 실행하세요.\nSWING_TO_FACING = True        # 문이 FacingOrientation 쪽으로 열리는 패밀리면 True\nHINGE_TO_HAND = True          # 경첩이 HandOrientation 쪽에 있는 패밀리면 True\nTAG = 'PDF자동생성'\nPX_W, PX_H = 840.0, 1189.0\n# ────────────────────────\n\nDATA = json.loads(r'''{\"1\":{\"walls\":[[368.19,776.554,365.313,789.268,5.557,0],[297.647,410.984,249.202,400.128,5.596,0],[340.278,304.419,265.74,287.792,5.621,0],[249.196,400.156,196.294,637.514,5.625,0],[290.767,214.95,273.97,289.628,5.618,0],[410.549,587.306,390.386,677.454,5.623,0],[265.74,287.792,241.051,398.331,5.636,0],[383.187,314.001,340.276,304.429,5.63,0],[2